{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSID",
  "version": "0.1.0",
  "identifier": "io.github.dmbeta.wsid",
  "build": {
    "beforeDevCommand": "bun --cwd ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun --cwd ui run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WSID — What Should I Do?",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
