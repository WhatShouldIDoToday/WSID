{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSID",
  "version": "0.1.0",
  "identifier": "io.github.whatshouldidotoday.wsid",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WSID — What Should I Do?",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "nsis"],
    "publisher": "WhatShouldIDoToday",
    "shortDescription": "Offline task manager that ranks what to do next",
    "longDescription": "WSID (What Should I Do?) is an offline-first task manager with a desktop app, a terminal interface, and an MCP server for local AI agents.",
    "category": "Productivity",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
